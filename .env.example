ENABLE_GPT=true
# Set to true to enable quiz auto-answer feature
GEMINI_API_KEY=
# Free-tier Gemini API key from Google AI Studio
GEMINI_MODEL=gemini-2.5-flash-lite
SMART_TRACK_WAIT_SECONDS=3.5
QUIZ_ALLOW_LOCAL_FALLBACK=false
QUIZ_DEBUG=false
# Optional: set this to Naruto Botto's exact user ID for better message detection
NARUTO_BOTTO_USER_ID=
